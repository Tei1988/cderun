      --cderun-restart string              Override restart setting (highest priority, can be used after subcommand)
      --cderun-runtime string              Override runtime setting (highest priority, can be used after subcommand)
      --cderun-security-opt stringArray    Override security-opt setting (highest priority, can be used after subcommand)
      --cderun-sensitive-env stringArray   Override sensitive-env setting (highest priority, can be used after subcommand)
      --cderun-shm-size string             Override shm-size setting (highest priority, can be used after subcommand)
      --cderun-socket-path string          Override socket-path setting (highest priority, can be used after subcommand)
      --cderun-strict-env                  Override strict-env setting (highest priority, can be used after subcommand)
      --cderun-sysctl stringArray          Override sysctl setting (highest priority, can be used after subcommand)
      --cderun-tool-config string          Override tool-config setting (highest priority, can be used after subcommand)
      --cderun-tty                         Override tty setting (highest priority, can be used after subcommand)
      --cderun-ulimit stringArray          Override ulimit setting (highest priority, can be used after subcommand)
      --cderun-user string                 Override user setting (highest priority, can be used after subcommand)
      --cderun-workdir string              Override workdir setting (highest priority, can be used after subcommand)
      --cgroupns string                    Cgroup namespace to use
      --config string                      Path to cderun config file
      --cpu-shares int                     CPU shares (relative weight)
      --cpus float                         Number of CPUs
      --cpuset-cpus string                 CPUs in which to allow execution (0-3, 0,1)
      --cpuset-mems string                 MEMs in which to allow execution (0-3, 0,1)
      --device stringArray                 Add a host device to the container
      --diagnosis                          Show system diagnostics and available tools
      --diagnosis-format string            Diagnosis output format (yaml, json, simple) (default "yaml")
      --dns stringArray                    Set custom DNS servers
      --dns-option stringArray             Set DNS options
      --dns-search stringArray             Set custom DNS search domains
      --dry-run                            Preview container configuration without execution
  -f, --dry-run-format string              Output format (yaml, json, simple) (default "yaml")
      --engine string                      Container engine to use (docker/podman/containerd)
      --entrypoint stringArray             Overwrite the default ENTRYPOINT of the image
  -e, --env stringArray                    Set environment variables
      --expose stringArray                 Expose a port or a range of ports
      --gpus string                        GPU devices to request
      --group-add stringArray              Add supplementary groups to the container (name or GID)
      --hang-timeout string                Grace period after I/O completion before force-terminating the container (e.g. 10s, 5s) (default "10s")
  -h, --help                               help for cderun
      --hostname string                    Container host name
      --image string                       Docker image to use
      --init                               Run an init process inside the container to forward signals and reap processes
  -i, --interactive                        Keep STDIN open even if not attached
      --ipc string                         IPC namespace to use
      --log-format string                  Set log format (text, json) (default "text")
      --log-level string                   Set log level (error, warn, info, debug, trace) (default "error")
      --log-timestamp                      Include timestamp in logs (default true)
  -m, --memory string                      Memory limit
      --mount stringArray                  Attach a filesystem mount to the container
      --mount-all-tools                    Mount all defined tools into the container
      --mount-cderun                       Mount cderun binary for use inside container
      --mount-cderun-path string           Host path to cderun binary to mount inside container
      --mount-cderun-socket                Mount cderun Control Socket into container for nested execution (experimental)
      --mount-socket                       Mount the container runtime socket into the container
      --mount-socket-path string           Path where the socket should be mounted inside the container (defaults to host path)
      --mount-tools string                 Mount specified tools into the container
      --network string                     Connect a container to a network (default "bridge")
      --oci-runtime string                 OCI runtime to use (e.g. runc, crun, nvidia, kata)
      --pid string                         PID namespace to use
      --pids-limit int                     Tune container pids limit
      --prefetch string                    Prefetch specified tool images (comma-separated list)
      --prefetch-all                       Prefetch all images defined in .tools.yaml
      --privileged                         Give extended privileges to this container
      --prune                              Remove stopped orphan containers created by cderun
  -p, --publish stringArray                Publish a container's port(s) to the host
  -P, --publish-all                        Publish all exposed ports to random ports
      --pull string                        Pull image before running (always, missing, never) (default "missing")
      --pull-backoff-base string           Base duration for exponential backoff during image pull (e.g. 1s, 500ms) (default "1s")
      --pull-max-retries int               Maximum number of retries for image pull (default 3)
      --read-only                          Mount the container's root filesystem as read-only
      --remove                             Automatically remove the container when it exits (default true)
      --restart string                     Restart policy to apply when a container exits
      --runtime string                     Container engine to use (docker/podman/containerd) [deprecated: use engine]
      --security-opt stringArray           Configure security options
      --sensitive-env stringArray          List of environment variable patterns to mask (default masks all variables)
      --shm-size string                    Size of /dev/shm (e.g. 512m, 1g, 2147483648)
      --socket-path string                 Path to the container runtime socket on the host
      --strict-env                         Require all environment variables to be present on the host
      --sysctl stringArray                 Set kernel parameters (sysctl) (e.g. net.ipv4.ip_forward=1)
      --tool-config string                 Path to tools config file
  -t, --tty                                Allocate a pseudo-TTY
      --ulimit stringArray                 Set ulimits (e.g. nofile=65535:65535)
  -u, --user string                        Username or UID (format: <name|uid>[:<group|gid>])
  -v, --version                            version for cderun
  -w, --workdir string                     Working directory inside the container
